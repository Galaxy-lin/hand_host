{
  "schema": "dexhand.integration_kit.v1",
  "hand_id": "hand2",
  "display_name": "hand2 总线舵机手",
  "model_xml": "model/right_hand_tactile.xml",
  "driver": {
    "source": "driver_adapter"
  },
  "driver_source": "driver_adapter",
  "motor": {
    "kind": "python_adapter",
    "protocols": [
      "controller",
      "direct"
    ],
    "default_protocol": "controller",
    "default_baudrates": {
      "controller": 9600,
      "direct": 115200
    },
    "actuator_order": [
      "if_mcp_act",
      "if_rot_act",
      "if_pip_act",
      "if_dip_act",
      "mf_mcp_act",
      "mf_rot_act",
      "mf_pip_act",
      "mf_dip_act",
      "rf_mcp_act",
      "rf_rot_act",
      "rf_pip_act",
      "rf_dip_act",
      "th_cmc_act",
      "th_axl_act",
      "th_mcp_act",
      "th_ipl_act"
    ],
    "force_control_supported": false,
    "adapter_config": {
      "command_debounce_ms": 30,
      "telemetry_period_ms": 100,
      "merge_interval_ms": 30,
      "telemetry_interval_ms": 100,
      "teleop_move_time_ms": 72,
      "position_polling_enabled": false
    }
  },
  "tactile": {
    "default_baudrate": 460800,
    "adapter_source": "tactile_adapter",
    "layout": {
      "patches": [
        {
          "group": "手掌",
          "rows": 16,
          "name": "palm",
          "display_name": "手掌",
          "cols": 16,
          "site_transform": "flip_horizontal"
        },
        {
          "group": "食指",
          "rows": 4,
          "name": "if_mid_pad",
          "display_name": "食指中节垫",
          "cols": 7,
          "site_transform": "identity"
        },
        {
          "group": "食指",
          "rows": 4,
          "name": "if_distal_pad",
          "display_name": "食指远节垫",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "食指",
          "rows": 6,
          "name": "if_tip",
          "display_name": "食指指尖",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "中指",
          "rows": 4,
          "name": "mf_mid_pad",
          "display_name": "中指中节垫",
          "cols": 7,
          "site_transform": "identity"
        },
        {
          "group": "中指",
          "rows": 4,
          "name": "mf_distal_pad",
          "display_name": "中指远节垫",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "中指",
          "rows": 6,
          "name": "mf_tip",
          "display_name": "中指指尖",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "无名指",
          "rows": 4,
          "name": "rf_mid_pad",
          "display_name": "无名指中节垫",
          "cols": 7,
          "site_transform": "identity"
        },
        {
          "group": "无名指",
          "rows": 4,
          "name": "rf_distal_pad",
          "display_name": "无名指远节垫",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "无名指",
          "rows": 6,
          "name": "rf_tip",
          "display_name": "无名指指尖",
          "cols": 7,
          "site_transform": "flip_vertical"
        },
        {
          "group": "拇指",
          "rows": 4,
          "name": "th_pad",
          "display_name": "拇指掌侧垫",
          "cols": 7,
          "site_transform": "rotate_180"
        },
        {
          "group": "拇指",
          "rows": 6,
          "name": "th_tip",
          "display_name": "拇指指尖",
          "cols": 7,
          "site_transform": "rotate_180"
        }
      ]
    },
    "adapter_config": {
      "frame_format": "patches",
      "baseline_threshold": 0,
      "baseline_frames": 30,
      "value_scale": 255
    },
    "kind": "external_python"
  },
