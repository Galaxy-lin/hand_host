{
  "schema": "dexhand.hand.v1",
  "hand_id": "hand1",
  "display_name": "hand1 原灵巧手",
  "preset": false,
  "removable": true,
  "driver": {
    "kind": "python",
    "path": "driver_adapter/driver.py",
    "class": "HandDriver"
  },
  "motor": {
    "kind": "python_adapter",
    "protocols": [
      "hand1"
    ],
    "default_protocol": "hand1",
    "default_baudrates": {
      "hand1": 230400
    },
    "force_control_supported": true,
    "adapter_config": {
      "command_debounce_ms": 16,
      "telemetry_period_ms": 150,
      "merge_interval_ms": 16,
      "telemetry_interval_ms": 150
    },
    "actuator_order": [
      "act_Thumb_joint0",
      "act_Thumb_joint1",
      "act_Thumb_joint2",
      "act_Thumb_joint3",
      "act_Index_joint1",
      "act_Index_joint2",
      "act_Index_joint3",
      "act_Index_joint4",
      "act_Middle_joint1",
      "act_Middle_joint2",
      "act_Middle_joint3",
      "act_Middle_joint4",
      "act_Ring_joint1",
      "act_Ring_joint2",
      "act_Ring_joint3",
      "act_Ring_joint4"
    ]
  },
  "tactile": {
    "kind": "external_python",
    "default_baudrate": 115200,
    "adapter_config": {
      "frame_format": "adapter_dict",
      "value_scale": 255.0,
      "baseline_frames": 30,
      "baseline_threshold": 0.0
    },
    "adapter_path": "tactile_adapter/tactile_adapter.py",
    "adapter_class": "TactileAdapter"
  },
  "teleop": {
    "kind": "external_python",
    "wrist_link_name": "base_link",
    "adapter_config": {
      "input": "mediapipe_21x3_or_features",
      "output_unit": "degree",
      "smoothing_alpha": 0.55,
      "rate_limit_rad_per_s": 8.0,
      "paired_k": 5,
      "paired_sigma": 0.45
    },
    "adapter_path": "teleop_adapter/teleop_adapter.py",
    "adapter_class": "TeleopAdapter"
  },
  "resources": {
    "model": "model/1.xml",
