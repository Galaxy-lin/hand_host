          "name": "mf_distal_pad",
          "display_name": "中指远节垫",
          "group": "中指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "mf_tip",
          "display_name": "中指指尖",
          "group": "中指",
          "rows": 6,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "rf_mid_pad",
          "display_name": "无名指中节垫",
          "group": "无名指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "identity"
        },
        {
          "name": "rf_distal_pad",
          "display_name": "无名指远节垫",
          "group": "无名指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "rf_tip",
          "display_name": "无名指指尖",
          "group": "无名指",
          "rows": 6,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "th_pad",
          "display_name": "拇指掌侧垫",
          "group": "拇指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "rotate_180"
        },
        {
          "name": "th_tip",
          "display_name": "拇指指尖",
          "group": "拇指",
          "rows": 6,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "rotate_180"
        }
      ]
    },
    "adapter_path": "tactile_adapter/tactile_adapter.py",
    "adapter_class": "TactileAdapter"
  },
  "teleop": {
    "kind": "external_python",
    "wrist_link_name": "base_link",
    "adapter_config": {
      "input": "mediapipe_21x3_or_features",
