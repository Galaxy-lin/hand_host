{
  "schema": "dexhand.hand.v1",
  "hand_id": "hand3",
  "display_name": "hand3 hand1升级版",
  "preset": false,
  "removable": true,
  "driver": {
    "kind": "python",
    "path": "driver_adapter/driver.py",
    "class": "HandDriver"
  },
  "motor": {
    "kind": "python_adapter",
    "protocols": [
      "hand1"
    ],
    "default_protocol": "hand1",
    "default_baudrates": {
      "hand1": 230400
    },
    "force_control_supported": true,
    "adapter_config": {
      "command_debounce_ms": 16,
      "telemetry_period_ms": 150,
      "merge_interval_ms": 16,
      "telemetry_interval_ms": 150
    },
    "actuator_order": [
      "th1",
      "th2",
      "th3",
      "th4",
      "idx1",
      "idx2",
      "idx3",
      "idx4",
      "mid1",
      "mid2",
      "mid3",
      "mid4",
      "rng1",
      "rng2",
      "rng3",
      "rng4"
    ]
  },
  "tactile": {
    "kind": "external_python",
    "default_baudrate": 460800,
    "adapter_config": {
      "frame_format": "patches",
      "value_scale": 255.0,
      "baseline_frames": 30,
      "baseline_threshold": 0.0
    },
    "layout": {
      "patches": [
        {
          "name": "palm",
          "display_name": "手掌",
          "group": "手掌",
          "rows": 16,
          "cols": 16,
          "display_transform": "identity",
          "site_transform": "flip_horizontal"
        },
        {
          "name": "if_mid_pad",
          "display_name": "食指中节垫",
          "group": "食指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "identity"
        },
        {
          "name": "if_distal_pad",
          "display_name": "食指远节垫",
          "group": "食指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "if_tip",
          "display_name": "食指指尖",
          "group": "食指",
          "rows": 6,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "flip_vertical"
        },
        {
          "name": "mf_mid_pad",
          "display_name": "中指中节垫",
          "group": "中指",
          "rows": 4,
          "cols": 7,
          "display_transform": "identity",
          "site_transform": "identity"
